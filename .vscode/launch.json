{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Run Benchmark (SAHI vs Resize)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_benchmark.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Python: Generate Synthetic Dataset",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/generate_dataset.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Python: Run ONNX Edge Demo",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_onnx_inference.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Python: Run Pytest",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-v",
                "tests"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}
